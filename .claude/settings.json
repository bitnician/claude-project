{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:push)",
      "Bash(pnpm auth:generate)",
      "Bash(pnpm add:*)",
      "Bash(git push:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  }
}
